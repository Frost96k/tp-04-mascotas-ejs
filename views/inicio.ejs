<section class="inicio">
  <div class="hero">
    <p class="eyebrow">Adopción responsable</p>
    <h1>Mascotas que esperan un hogar</h1>
    <p>Conocé animales rescatados y encontrá a tu próximo compañero.</p>
    <a class="boton" href="/mascotas">Ver catálogo de mascotas</a>
  </div>

  <section class="carrusel" aria-label="Mascotas que buscan familia" data-carrusel>
    <div class="diapositivas">
      <figure class="diapositiva activa">
        <img src="/img/rott.jpeg" alt="Luna, una perra mestiza en adopción">
        <figcaption><strong>Luna</strong><span>Busca una familia para compartir paseos.</span></figcaption>
      </figure>
      <figure class="diapositiva">
        <img src="/img/gatog.jpg" alt="Milo, un gato reservado">
        <figcaption><strong>Milo</strong><span>Un compañero tranquilo y curioso.</span></figcaption>
      </figure>
      <figure class="diapositiva">
        <img src="/img/Conejito-blano.jpg" alt="Nala, una conejita en adopción">
        <figcaption><strong>Nala</strong><span>Pequeña y dócil, espera una familia responsable.</span></figcaption>
      </figure>
      <figure class="diapositiva">
        <img src="/img/perro.jpg" alt="Toto, un perro de tamaño grande">
        <figcaption><strong>Toto</strong><span>Un compañero sereno y cariñoso.</span></figcaption>
      </figure>
      <figure class="diapositiva">
        <img src="/img/gato.jpg" alt="Kiwi, una gata cachorra en adopción">
        <figcaption><strong>Kiwi</strong><span>Una cachorra lista para conocer su hogar.</span></figcaption>
      </figure>
    </div>
    <div class="controles-carrusel">
      <button type="button" class="control-carrusel" data-anterior aria-label="Ver mascota anterior">←</button>
      <p aria-live="polite"><span data-indice>1</span> de 5</p>
      <button type="button" class="control-carrusel" data-siguiente aria-label="Ver mascota siguiente">→</button>
    </div>
  </section>
</section>
